{
  "openapi": "3.0.0",
  "info": {
    "title": "GameVault API",
    "version": "1.0.0",
    "description": "Biblioteca de jogos: catálogo, empréstimos, avaliações, curadoria e administração. Faça login em POST /api/auth e cole somente o token retornado em Authorize. Permissões por perfil estão descritas em cada operação; a API existente responde 401 também para perfil incorreto. Respostas de erro seguem {error: string}."
  },
  "servers": [
    {
      "url": "/",
      "description": "Mesma origem e porta da documentação (local ou backend Render)."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token opaco de POST /api/auth. Não é JWT; não persiste entre reinícios."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "enum": [
              "admin",
              "client"
            ],
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role",
          "token"
        ]
      },
      "Client": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "jogador@example.com"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Registration": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "register"
            ]
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "format": "password"
          }
        },
        "required": [
          "action",
          "name",
          "email",
          "password"
        ]
      },
      "GameInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Meu jogo"
          },
          "category": {
            "type": "string",
            "example": "Aventura"
          },
          "platform": {
            "type": "string",
            "example": "PC"
          },
          "year": {
            "type": "integer",
            "minimum": 1970,
            "maximum": 2100,
            "example": 2024
          },
          "cover": {
            "type": "string",
            "description": "URL http(s) ou string vazia."
          },
          "description": {
            "type": "string"
          },
          "featured": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "on"
                ]
              }
            ]
          }
        },
        "required": [
          "title",
          "category",
          "platform",
          "year"
        ]
      },
      "Game": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "featured": {
            "type": "boolean"
          },
          "cover": {
            "type": "string"
          },
          "coverPublicId": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "players": {
            "type": "string"
          },
          "age": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "genre": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "ai": {
            "type": "string"
          },
          "visits": {
            "type": "integer"
          },
          "steamAppId": {
            "type": "string"
          },
          "alreadyImported": {
            "type": "boolean"
          },
          "recommendationReason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "platform",
          "year"
        ]
      },
      "CatalogGame": {
        "type": "object",
        "properties": {
          "appId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "cover": {
            "type": "string"
          },
          "storeUrl": {
            "type": "string"
          }
        },
        "required": [
          "appId",
          "title",
          "cover",
          "storeUrl"
        ]
      },
      "Booking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "clientId": {
            "type": "string"
          },
          "gameId": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "Solicitado",
              "Confirmada",
              "Recusado",
              "Devolvido",
              "Cancelado"
            ]
          },
          "note": {
            "type": "string"
          },
          "reviewedBy": {
            "type": "string"
          },
          "reviewedAt": {
            "type": "string",
            "format": "date-time"
          },
          "client": {
            "type": "string"
          },
          "clientEmail": {
            "type": "string"
          },
          "game": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "clientId",
          "gameId",
          "date",
          "status"
        ]
      },
      "Review": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "clientId": {
            "type": "string"
          },
          "gameId": {
            "type": "string"
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "comment": {
            "type": "string"
          },
          "reply": {
            "type": "string"
          },
          "client": {
            "type": "string"
          },
          "game": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "clientId",
          "gameId",
          "rating",
          "comment",
          "reply"
        ]
      },
      "Dashboard": {
        "type": "object",
        "properties": {
          "clients": {
            "type": "integer"
          },
          "bookings": {
            "type": "integer"
          },
          "pendingBookings": {
            "type": "integer"
          },
          "reviews": {
            "type": "integer"
          },
          "games": {
            "type": "integer"
          },
          "gameStats": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "bookings": {
                  "type": "integer"
                },
                "avgRating": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "description": "String com uma casa decimal, ou zero numérico sem avaliações."
                },
                "reviewCount": {
                  "type": "integer"
                }
              }
            }
          },
          "categoryStats": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "recent": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Booking"
            }
          }
        }
      },
      "Me": {
        "type": "object",
        "properties": {
          "client": {
            "$ref": "#/components/schemas/Client"
          },
          "bookings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Booking"
            }
          },
          "reviews": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Review"
            }
          }
        },
        "required": [
          "client",
          "bookings",
          "reviews"
        ]
      },
      "Recommendation": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "games": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Game"
            }
          }
        },
        "required": [
          "source",
          "answer",
          "games"
        ]
      }
    }
  },
  "paths": {
    "/api/games/{id}/cover": {
      "post": {
        "tags": [
          "Jogos"
        ],
        "summary": "Enviar ou substituir capa do jogo",
        "description": "Acesso: admin. Envie somente imagem (PNG, JPEG ou WebP), menor que 5 MiB; MIME e assinatura precisam corresponder. Sem campos textuais. Pasta fixa gamevault/covers. Salva URL HTTPS e public_id no payload do jogo, preserva a capa anterior se falhar e tenta remover recursos sem vínculo. O Cloudinary verifica se a imagem é decodificável.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador do registro retornado pela API.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "imagem"
                ],
                "additionalProperties": false,
                "properties": {
                  "imagem": {
                    "type": "string",
                    "format": "binary",
                    "description": "PNG, JPEG ou WebP menor que 5 MiB."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Capa persistida; retorna o jogo atualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Game"
                }
              }
            }
          },
          "400": {
            "description": "Arquivo ausente, multipart inválido ou campos extras.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Requer sessão admin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Jogo não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Jogo alterado ou excluído durante o upload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Arquivo excede o limite.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type, tipo ou assinatura inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Falha de persistência; capa anterior preservada e limpeza tentada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Falha de comunicação ou resposta inválida do Cloudinary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Cloudinary não configurado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Entrar ou cadastrar cliente",
        "description": "action=register cria cliente; os demais valores fazem login. E-mail é normalizado. Registro exige nome, e-mail contendo @ e senha de 6 caracteres. Token opaco em memória; reinício encerra sessões.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/Login"
                  },
                  {
                    "$ref": "#/components/schemas/Registration"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "201": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Corpo JSON ou campos inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sessão ausente, inválida ou perfil sem permissão.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflito com o estado atual.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/games": {
      "get": {
        "tags": [
          "Jogos"
        ],
        "summary": "Consultar catálogo",
        "description": "Omite visits; resolve capa por URL própria, mapa local ou fontes remotas.",
        "security": [],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Busca parcial por título, categoria ou plataforma, sem diferenciar maiúsculas."
          },
          {
            "name": "featured",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Somente o valor literal true filtra destaques."
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Game"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Jogos"
        ],
        "summary": "Cadastrar jogo",
        "description": "Acesso: admin. ",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GameInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Game"
                }
              }
            }
          },
          "400": {
            "description": "Corpo JSON ou campos inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sessão ausente, inválida ou perfil sem permissão.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/games/{id}": {
      "put": {
        "tags": [
          "Jogos"
        ],
        "summary": "Atualizar jogo",
        "description": "Acesso: admin. Título, categoria, plataforma e ano são obrigatórios em toda atualização. Campos opcionais omitidos são redefinidos conforme o cadastro; demais atributos existentes são preservados.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador do registro retornado pela API.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GameInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Game"
                }
              }
            }
          },
          "400": {
            "description": "Corpo JSON ou campos inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sessão ausente, inválida ou perfil sem permissão.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Registro não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Jogos"
        ],
        "summary": "Excluir jogo e suas avaliações",
        "description": "Acesso: admin. Qualquer empréstimo vinculado, inclusive concluído, impede exclusão.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador do registro retornado pela API.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "deleted"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Sessão ausente, inválida ou perfil sem permissão.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Registro não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflito com o estado atual.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/steam": {
      "get": {
        "tags": [
          "Steam"
        ],
        "summary": "Buscar jogos na Steam Store",
        "description": "",
        "security": [],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            },
            "description": "Título a procurar.",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string"
                    },
                    "games": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CatalogGame"
                      }
                    }
                  },
                  "required": [
                    "source",
                    "games"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Corpo JSON ou campos inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Serviço externo indisponível.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/steam/import": {
      "post": {
        "tags": [
          "Steam"
        ],
        "summary": "Importar metadados de um jogo",
        "description": "Acesso: admin. 200 e alreadyImported=true se o appId já estiver cadastrado; 201 em nova importação.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "appId": {
                    "type": "string",
                    "pattern": "^\\d{1,12}$",
                    "example": "1145360"
                  }
                },
                "required": [
                  "appId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Game"
                }
              }
            }
          },
          "201": {
            "description": "Operação concluída.",
